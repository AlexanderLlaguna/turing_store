rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function sesionIniciada() {
      return request.auth != null;
    }

    function esPropietario(usuarioId) {
      return sesionIniciada() && request.auth.uid == usuarioId;
    }

    function esAdmin() {
      return sesionIniciada()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    match /usuarios/{usuarioId} {
      allow create: if esPropietario(usuarioId)
        && request.resource.data.rol == "cliente";
      allow read: if esPropietario(usuarioId) || esAdmin();
      allow update: if esPropietario(usuarioId)
        && request.resource.data.rol == resource.data.rol;
      allow delete: if esAdmin();
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        sesionIniciada()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["stock", "disponible", "actualizadoEn"])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.stock
      );
    }

    match /pedidos/{pedidoId} {
      allow create: if sesionIniciada()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == "confirmado";
      allow read: if esPropietario(resource.data.usuarioId) || esAdmin();
      allow update, delete: if esAdmin();
    }

    match /valoraciones/{valoracionId} {
      allow read: if true;
      allow create: if sesionIniciada()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.puntuacion >= 1
        && request.resource.data.puntuacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 3
        && request.resource.data.comentario.size() <= 300;
      allow update: if sesionIniciada()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.puntuacion >= 1
        && request.resource.data.puntuacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 3
        && request.resource.data.comentario.size() <= 300;
      allow delete: if esAdmin()
        || (sesionIniciada() && resource.data.usuarioId == request.auth.uid);
    }
  }
}

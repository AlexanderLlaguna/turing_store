rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    |--------------------------------------------------------------------------
    | FUNCIONES GENERALES
    |--------------------------------------------------------------------------
    */

    function sesionIniciada() {
      return request.auth != null;
    }

    function esPropietario(usuarioId) {
      return sesionIniciada()
        && request.auth.uid == usuarioId;
    }

    function esAdmin() {
      return sesionIniciada()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }


    // La compra y el descuento de stock deben confirmarse juntos.
    function descuentoPorPedido(productoId) {
      let datos = request.resource.data;
      let ruta = /databases/$(database)/documents/pedidos/$(datos.ultimoPedidoId);
      let pedido = getAfter(ruta).data;
      let indice = datos.indicePedido;
      let item = pedido.productos[indice];
      return !exists(ruta)
        && pedido.usuarioId == request.auth.uid
        && pedido.fecha == request.time
        && indice is int && indice >= 0 && indice < 8
        && item.productoId == productoId
        && item.cantidad is int && item.cantidad > 0
        && item.keys().hasOnly(["productoId", "nombre", "cantidad", "precio", "subtotal"])
        && item.nombre == resource.data.nombre
        && item.precio == resource.data.precio
        && item.subtotal == item.precio * item.cantidad
        && resource.data.disponible == true
        && datos.stock == resource.data.stock - item.cantidad;
    }

    function lineaPedidoValida(items, indice, pedidoId) {
      let item = items[indice];
      let producto = getAfter(
        /databases/$(database)/documents/productos/$(item.productoId)
      ).data;
      return producto.ultimoPedidoId == pedidoId
        && producto.indicePedido == indice
        && producto.actualizadoEn == request.time;
    }

    function lineaOpcionalValida(items, indice, pedidoId) {
      return items.size() <= indice || lineaPedidoValida(items, indice, pedidoId);
    }

    function subtotalOpcional(items, indice) {
      return items.size() > indice ? items[indice].subtotal : 0;
    }

    function pedidoConsistente(pedidoId) {
      let items = request.resource.data.productos;
      return items.size() <= 8
        && lineaPedidoValida(items, 0, pedidoId)
        && lineaOpcionalValida(items, 1, pedidoId)
        && lineaOpcionalValida(items, 2, pedidoId)
        && lineaOpcionalValida(items, 3, pedidoId)
        && lineaOpcionalValida(items, 4, pedidoId)
        && lineaOpcionalValida(items, 5, pedidoId)
        && lineaOpcionalValida(items, 6, pedidoId)
        && lineaOpcionalValida(items, 7, pedidoId)
        && request.resource.data.total ==
          items[0].subtotal
          + subtotalOpcional(items, 1) + subtotalOpcional(items, 2)
          + subtotalOpcional(items, 3) + subtotalOpcional(items, 4)
          + subtotalOpcional(items, 5) + subtotalOpcional(items, 6)
          + subtotalOpcional(items, 7);
    }

    /*
    |--------------------------------------------------------------------------
    | USUARIOS
    |--------------------------------------------------------------------------
    */

    match /usuarios/{usuarioId} {

      allow create: if esPropietario(usuarioId)
        && request.resource.data.keys().hasAll([
          "nombre",
          "correo",
          "rol",
          "fechaRegistro"
        ])
        && request.resource.data.keys().hasOnly([
          "nombre",
          "correo",
          "rol",
          "fechaRegistro",
          "fotoPerfil",
          "fotoGoogle",
          "ultimoAcceso",
          "actualizadoEn"
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo is string
        && request.resource.data.correo.size() >= 5
        && request.resource.data.correo.size() <= 150
        && request.resource.data.rol == "cliente"
        && request.resource.data.fechaRegistro
           == request.time;

      allow read: if esPropietario(usuarioId)
        || esAdmin();

      allow update: if esPropietario(usuarioId)
        && request.resource.data.rol
           == resource.data.rol
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo is string
        && request.resource.data
           .diff(resource.data)
           .affectedKeys()
           .hasOnly([
             "nombre",
             "correo",
             "fotoPerfil",
             "fotoGoogle",
             "ultimoAcceso",
             "actualizadoEn"
           ]);

      allow delete: if esAdmin();
    }

    /*
    |--------------------------------------------------------------------------
    | PRODUCTOS
    |--------------------------------------------------------------------------
    */

    match /productos/{productoId} {

      // El catálogo puede ser consultado sin iniciar sesión.
      allow read: if true;

      // Solamente el administrador puede crear o eliminar productos.
      allow create, delete: if esAdmin();

      /*
       * El administrador puede modificar cualquier dato.
       * Un cliente solamente puede reducir el stock durante una compra.
       */
      allow update: if esAdmin()
        || (
          sesionIniciada()
          && descuentoPorPedido(productoId)
          && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "stock",
               "disponible",
               "actualizadoEn",
               "ultimoPedidoId",
               "indicePedido"
             ])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock
             <= resource.data.stock
          && request.resource.data.disponible
             == (request.resource.data.stock > 0)
          && request.resource.data.actualizadoEn
             == request.time
        );
    }

    /*
    |--------------------------------------------------------------------------
    | PEDIDOS
    |--------------------------------------------------------------------------
    */

    match /pedidos/{pedidoId} {

      allow create: if sesionIniciada()
        && request.resource.data.keys().hasAll([
          "numeroPedido",
          "usuarioId",
          "usuarioCorreo",
          "productos",
          "total",
          "fecha",
          "estado",
          "pago"
        ])
        && request.resource.data.keys().hasOnly([
          "numeroPedido",
          "usuarioId",
          "usuarioCorreo",
          "productos",
          "total",
          "fecha",
          "estado",
          "pago"
        ])
        && request.resource.data.usuarioId
           == request.auth.uid
        && request.resource.data.numeroPedido is string
        && request.resource.data.usuarioCorreo is string
        && request.resource.data.productos is list
        && request.resource.data.productos.size() > 0
        && pedidoConsistente(pedidoId)
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.fecha
           == request.time
        && request.resource.data.estado
           == "confirmado"
        && request.resource.data.pago is map
        && request.resource.data.pago.keys().hasAll([
          "metodo",
          "nombreMetodo",
          "estado",
          "referencia"
        ])
        && request.resource.data.pago.keys().hasOnly([
          "metodo",
          "nombreMetodo",
          "estado",
          "referencia"
        ])
        && request.resource.data.pago.metodo in [
          "tarjeta",
          "transferencia",
          "efectivo"
        ]
        && request.resource.data.pago.nombreMetodo is string
        && request.resource.data.pago.estado in [
          "aprobado",
          "pendiente"
        ]
        && request.resource.data.pago.referencia is string;

      allow read: if esAdmin()
        || (
          sesionIniciada()
          && resource.data.usuarioId
             == request.auth.uid
        );

      allow update, delete: if esAdmin();
    }

    /*
    |--------------------------------------------------------------------------
    | VALORACIONES
    |--------------------------------------------------------------------------
    */

    match /valoraciones/{valoracionId} {

      function valoracionValida() {
        return request.resource.data.keys().hasAll([
            "usuarioId",
            "usuarioNombre",
            "productoId",
            "puntuacion",
            "comentario",
            "fecha"
          ])
          && request.resource.data.keys().hasOnly([
            "usuarioId",
            "usuarioNombre",
            "productoId",
            "puntuacion",
            "comentario",
            "fecha"
          ])
          && request.resource.data.usuarioId is string
          && request.resource.data.usuarioNombre is string
          && request.resource.data.usuarioNombre.size() >= 2
          && request.resource.data.usuarioNombre.size() <= 100
          && request.resource.data.productoId is string
          && request.resource.data.puntuacion is number
          && request.resource.data.puntuacion >= 1
          && request.resource.data.puntuacion <= 5
          && request.resource.data.comentario is string
          && request.resource.data.comentario.size() >= 3
          && request.resource.data.comentario.size() <= 300
          && request.resource.data.fecha
             == request.time;
      }

      // Las valoraciones son públicas.
      allow read: if true;

      allow create: if sesionIniciada()
        && valoracionValida()
        && request.resource.data.usuarioId
           == request.auth.uid
        && valoracionId
           == request.auth.uid
              + "_"
              + request.resource.data.productoId
        && exists(
          /databases/$(database)/documents/productos/$(request.resource.data.productoId)
        );

      allow update: if sesionIniciada()
        && valoracionValida()
        && resource.data.usuarioId
           == request.auth.uid
        && request.resource.data.usuarioId
           == resource.data.usuarioId
        && request.resource.data.productoId
           == resource.data.productoId
        && valoracionId
           == request.auth.uid
              + "_"
              + resource.data.productoId;

      allow delete: if esAdmin()
        || (
          sesionIniciada()
          && resource.data.usuarioId
             == request.auth.uid
        );
    }
  }
}
